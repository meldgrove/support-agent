# What a server of the newest release has in .env, with fake values, for the
# job "Compose files of the newest release" (ci.yml). The job sets
# SUPPORT_AGENT_VERSION and COMPOSE_FILE itself. Add a setting here only once
# a release asks operators for it. Public file: no real secrets.
POSTGRES_PASSWORD=compat-only-password
DATABASE_URL=postgres://support_agent:compat-only-password@postgres:5432/support_agent
APP_URL=https://support-agent.example.invalid
AUTH_SECRET=compat-only-not-a-secret-compat-only-not-a-secret
ENCRYPTION_KEY=Y29tcGF0LW9ubHktbm90LWEtc2VjcmV0LWtleS0wMDE=
OIDC_ISSUER=https://sso.example.invalid/realms/support-agent
OIDC_CLIENT_ID=support-agent
OIDC_CLIENT_SECRET=compat-only
